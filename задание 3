#include <iostream>
#include <opencv2/opencv.hpp>

using namespace std;
using namespace cv;

int main() {
    // путь: "C:/Users/User/Pictures/photo.jpg"
    string imagePath = "C:/Users/User/Pictures/photo.jpg";
    
    // Загружаем изображение
    Mat image = imread(imagePath);
    
    if (image.empty()) {
        cerr << "Ошибка: не удалось загрузить изображение по пути " << imagePath << endl;
        return -1;
    }
    
    cout << "изображение загружено. размер: " << image.cols << "x" << image.rows << endl;
    
    // Создаём окно для отображения
    namedWindow("Исходное изображение", WINDOW_NORMAL);
    namedWindow("Обработанное изображение", WINDOW_NORMAL);
    
    // Конвертируем в оттенки серого
    Mat grayImage;
    cvtColor(image, grayImage, COLOR_BGR2GRAY);
    
    // Применяем размытие по Гауссу
    Mat blurredImage;
    GaussianBlur(grayImage, blurredImage, Size(5, 5), 0);
    
    // Отображаем результаты
    imshow("Исходное изображение", image);
    imshow("Обработанное изображение", blurredImage);
    
    // Ждём нажатия клавиши
    waitKey(0);
    
    return 0;
}
